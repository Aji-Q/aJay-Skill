#!/usr/bin/env bash
# Session-start hook: injects J Trader context into agent sessions.
# Called by hooks.json via run-hook.cmd on SessionStart.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# v2.14.0 · 后台触发 update check · 结果写到 .cache/_global/update_prompt.md
# SKILL.md HARD-GATE-UPDATE-PROMPT 负责让 agent 读这个文件并展示给用户
# aJay 派生版没有上游 release 可升级：只有显式设了 AJAY_REPO=owner/repo 才检查
if [ -n "${AJAY_REPO:-}" ] && [ -z "${AJAY_NO_UPDATE_CHECK:-}" ] && command -v python3 >/dev/null 2>&1; then
  (
    cd "$PLUGIN_ROOT/skills/deep-analysis/scripts" 2>/dev/null
    python3 -c "
import sys, os
from pathlib import Path
sys.path.insert(0, '.')
try:
    from lib.update_check import check_for_update, format_prompt
    info = check_for_update()
    prompt_f = Path('.cache/_global/update_prompt.md')
    prompt_f.parent.mkdir(parents=True, exist_ok=True)
    if info is None:
        # 清掉旧 prompt · 保持状态一致
        if prompt_f.exists():
            prompt_f.unlink()
    else:
        prompt_f.write_text(format_prompt(info) + '\\n[agent] 请把上面消息展示给用户，收到 y/s/n 后用 lib.update_check.handle_answer() 处理。\\n', encoding='utf-8')
except Exception:
    pass
" 2>/dev/null &
  )
fi

# Build the context message with skill summaries
CONTEXT="$(cat <<'SKILLS_CONTEXT'
J Trader Research v1.2.0 已加载 · Maintained by aJay (Aji-Q)
美股研究主线；上游贡献与许可见 NOTICE。

## 可用技能

| 命令 | 说明 |
|---|---|
| `/ajay:analyze-stock <代码>` | 完整深度分析（多维数据 + 市场适配评审团 + J Trader 编辑式报告；美股自动补数链） |
| `/ajay:dcf <代码>` | DCF 估值 |
| `/ajay:comps <代码>` | 同行对标 |
| `/ajay:lbo <代码>` | LBO 压力测试 |
| `/ajay:scan-trap <代码>` | 杀猪盘检测 |
| `/ajay:segmental-model <代码>` | 分业务收入 bottom-up 建模 |

说"分析 XXX"即可开始深度分析。

## 更新检查

默认关闭。设了 `AJAY_REPO=Aji-Q/aJay-Skill` 时 hook 才后台查 GitHub release 并写 `.cache/_global/update_prompt.md`，存在则展示给用户并用 `lib.update_check.handle_answer(ans, latest)` 处理回答。

## 工作流提醒

深度分析是**两段式**的：
1. `stage1()` 自动采集数据 + 骨架分；**美股接着跑 `us_backfill.py <代码>` + `stage1_modeling()`**（SEC XBRL / moomoo 资金流 / 缠论结构）
2. **你必须介入**：读 panel.json → 3 个 investor-panel agent role-play 42 位参与评委 → `merge_panel.py` 合并 → 写 agent_analysis.json（带 analysis_input_hash）
3. `stage2()` 合并你的分析生成报告

⚠️ 不要跳过 agent 分析步骤直接出报告（除非用户明确要快速模式）。
SKILLS_CONTEXT
)"

# Output as JSON additionalContext for Claude Code hooks.
# 上游用 GNU sed 的 ':a;N;$!ba' 转义换行,macOS BSD sed 不认 → 输出非法 JSON,banner 每次都被静默丢弃;改用 python 编码
printf '%s' "$CONTEXT" | python3 -c 'import json, sys; print(json.dumps({"additionalContext": sys.stdin.read()}, ensure_ascii=False))'
