# aJay-Skill · 本地环境变量（可选）
# 把本文件复制为 .env 并填入你自己的值：
#   cp .env.example .env
#   # 然后编辑 .env 填 key

# ─── 东财妙想 Skills Hub API（推荐配置）──────────────────────
# 设置后 aJay-Skill 会优先使用官方 NLP API 做：
#   1. 中文名纠错（"北部港湾" 自动识别为 "北部湾港"）
#   2. 股票行情快照（稳定性远高于爬 push2.eastmoney.com）
# 获取 key（免费）: https://dl.dfcfs.com/m/itc4
MX_APIKEY=

# ─── 其他可选 ─────────────────────────────────────────────
# STOCK_NO_CACHE=1        # 禁用所有 API 缓存，强制重新拉取
# AJAY_NO_AUTO_OPEN=1      # 分析完不自动打开浏览器
# AJAY_DISABLE_GLOBAL_PEERS=1  # 关闭全球同行，只保留本地市场同行
# AJAY_GLOBAL_PEER_LIMIT=8     # 全球同行补全数量，支持 3-12

# --- aJay ---
# SEC EDGAR 要求 UA 带联系方式,us_backfill.py 必需
AJAY_SEC_UA="your name your@email"
# 可选:FMP 自有 key(不设则 6_research 由 agent 经 FMP MCP 填)
# FMP_APIKEY=
# 可选:设了才启用 GitHub 更新检查(owner/repo)
# AJAY_REPO=
